# Nothing is required: sign in from the dashboard and it stores what it needs in .kibb/.

# Optional — defaults to https://tradewinds.kibb.io
# KIBB_API_URL=https://tradewinds.kibb.io

# Optional — where company API keys and autopilot settings are kept (default .kibb/ in the project)
# KIBB_STORE_DIR=.kibb

# Optional — name new ships after random Discord bots (topstats.gg → Get Token); server-side only
# TOPSTATS_API_KEY=your_topstats_token

# Only for running the autopilot without the dashboard (src/workers/kibb-fleet.ts). A login key lasts
# 24 h unless you pass ttl_seconds (up to 31536000, a year); create-key with handle + passphrase and no
# ttl_seconds never expires. The autopilot stops when the key expires and warns 7 days, 1 day and 1 hour before.
# KIBB_API_KEY=tw_live_your_company_bound_key

# Session cookies are Secure only when the dashboard is reached over HTTPS (or a proxy sends
# X-Forwarded-Proto: https). Force it either way with:
# COOKIE_SECURE=true
